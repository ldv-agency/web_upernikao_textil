{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/cotizar", "destination": "/" },
    { "source": "/cotizar/:linea", "destination": "/" },
    { "source": "/whatsapp", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
